#!/usr/bin/env bash
# mission-control — run the Mission Control server and open its page.
#   mission-control      start the server when it isn't running (restarting it after server.py changed), then open the page
#   mission-control serve run the server in the foreground
#   mission-control stop | restart | status | logs
set -euo pipefail

# The project root, following symlinks to this script (e.g. one in ~/.local/bin).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd)

home=${MISSION_CONTROL_HOME:-$HOME/.mission-control}
port=${MISSION_CONTROL_PORT:-4747}
url="http://127.0.0.1:$port"
python=${MISSION_CONTROL_PYTHON:-python3}
pidfile=$home/server.pid
log=$home/server.log

health() { curl -fsS --max-time 1 "$url/api/health" 2>/dev/null; }
# json_field <field>: one field of the health JSON on stdin.
json_field() { "$python" -c 'import json, sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }

start() {
  "$python" "$root/server.py" --prepare
  mkdir -p "$home"
  nohup "$python" "$root/server.py" >>"$log" 2>&1 &
  echo $! >"$pidfile"
  disown
  for _ in $(seq 600); do
    if health >/dev/null; then return 0; fi
    sleep 0.1
  done
  echo "mission-control: the server did not start; last log lines:" >&2
  tail -n 20 "$log" >&2
  exit 1
}

stop() {
  local pid=""
  if status=$(health); then pid=$(json_field pid <<<"$status"); fi
  if [ -z "$pid" ] && [ -f "$pidfile" ]; then pid=$(cat "$pidfile"); fi
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    for _ in $(seq 600); do
      if ! kill -0 "$pid" 2>/dev/null; then break; fi
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null; fi
  fi
  rm -f "$pidfile"
}

open_board() {
  "$python" -c 'import sys; sys.path.insert(0, sys.argv[1]); from integrations import terminals; raise SystemExit(terminals.main(sys.argv[2:]))' "$root" --override-env MISSION_CONTROL_TERMINAL --override-env OMP_TERMINAL board "$board_url"
}

# The repository mission-control starts in is registered as a project, which the page opens on.
board_url=$url
register_project() {
  git -C "$PWD" rev-parse --show-toplevel >/dev/null 2>&1 || return 0
  local body project
  body=$("$python" -c 'import json, os; print(json.dumps({"path": os.getcwd()}))')
  project=$(curl -fsS --max-time 10 -H 'Content-Type: application/json' -d "$body" "$url/api/projects" |
    "$python" -c 'import json, sys, urllib.parse; print(urllib.parse.quote(json.load(sys.stdin)["project"]["id"], safe=""))')
  board_url="$url/?project=$project"
}

case "${1:-open}" in
  open)
    if status=$(health); then
      running=$(json_field codeMtime <<<"$status" | cut -d. -f1)
      for code in "$root"/*.py; do
        if [ "$(stat -f %m "$code")" -gt "$running" ]; then
          stop
          start
          break
        fi
      done
    else
      start
    fi
    register_project
    open_board
    ;;
  serve)
    "$python" "$root/server.py" --prepare
    exec "$python" "$root/server.py"
    ;;
  stop) stop ;;
  restart) stop; start; echo "mission-control: $url" ;;
  status)
    if status=$(health); then echo "mission-control: running at $url (pid $(json_field pid <<<"$status"))"; else echo "mission-control: not running"; exit 1; fi
    ;;
  logs) exec tail -n 100 -f "$log" ;;
  *) echo "usage: mission-control [open|serve|stop|restart|status|logs]" >&2; exit 2 ;;
esac
