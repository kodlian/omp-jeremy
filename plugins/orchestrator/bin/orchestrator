#!/usr/bin/env bash
# orchestrator — run the orchestrator server and open its board.
#   orchestrator       start the server when it isn't running (restarting it after server.py changed), then open the board
#   orchestrator serve run the server in the foreground
#   orchestrator stop | restart | status | logs
set -euo pipefail

# The project root, following symlinks to this script (e.g. one in ~/.local/bin).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd)

home=${KANBOARD_HOME:-$HOME/.kanboard}
port=${KANBOARD_PORT:-4747}
url="http://127.0.0.1:$port"
python=${KANBOARD_PYTHON:-python3}
pidfile=$home/server.pid
log=$home/server.log

health() { curl -fsS --max-time 1 "$url/api/health" 2>/dev/null; }
# json_field <field>: one field of the health JSON on stdin.
json_field() { "$python" -c 'import json, sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }

require_beads() {
  if ! command -v bd >/dev/null 2>&1; then
    echo "orchestrator: Beads is required; install it with 'brew install beads'." >&2
    exit 1
  fi
}

start() {
  require_beads
  mkdir -p "$home"
  "$python" "$root/server.py" --prepare
  nohup "$python" "$root/server.py" >>"$log" 2>&1 &
  echo $! >"$pidfile"
  disown
  for _ in $(seq 50); do
    if health >/dev/null; then return 0; fi
    sleep 0.1
  done
  echo "orchestrator: the server did not start; last log lines:" >&2
  tail -n 20 "$log" >&2
  exit 1
}

stop() {
  local pid=""
  if status=$(health); then pid=$(json_field pid <<<"$status"); fi
  if [ -z "$pid" ] && [ -f "$pidfile" ]; then pid=$(cat "$pidfile"); fi
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    for _ in $(seq 50); do
      if ! kill -0 "$pid" 2>/dev/null; then break; fi
      sleep 0.1
    done
  fi
  rm -f "$pidfile"
}

open_board() {
  "$python" -c 'import sys; sys.path.insert(0, sys.argv[1]); from integrations import terminals; raise SystemExit(terminals.main(sys.argv[2:]))' "$root" --override-env KANBOARD_TERMINAL --override-env OMP_TERMINAL board "$board_url"
}

# The checkout orchestrator starts from becomes the board's context and its registered flow, which the board opens on: new tasks branch from its branch and merge back into it.
board_url=$url
set_context() {
  git -C "$PWD" rev-parse --show-toplevel >/dev/null 2>&1 || return 0
  local body context flow
  body=$("$python" -c 'import json, os; print(json.dumps({"path": os.getcwd()}))')
  context=$(curl -fsS --max-time 10 -H 'Content-Type: application/json' -d "$body" "$url/api/context")
  echo "orchestrator: new tasks branch from $(json_field base <<<"$context") ($(json_field path <<<"$context"))"
  flow=$(curl -fsS --max-time 10 -H 'Content-Type: application/json' -d "$body" "$url/api/flows" |
    "$python" -c 'import json, sys, urllib.parse; print(urllib.parse.quote(json.load(sys.stdin)["flow"]["id"], safe=""))')
  board_url="$url/?flow=$flow"
}

case "${1:-open}" in
  open)
    if status=$(health); then
      running=$(json_field codeMtime <<<"$status" | cut -d. -f1)
      for code in "$root"/*.py; do
        if [ "$(stat -f %m "$code")" -gt "$running" ]; then
          stop
          start
          break
        fi
      done
    else
      start
    fi
    set_context
    open_board
    ;;
  serve)
    require_beads
    "$python" "$root/server.py" --prepare
    exec "$python" "$root/server.py"
    ;;
  stop) stop ;;
  restart) stop; start; echo "orchestrator: $url" ;;
  status)
    if status=$(health); then echo "orchestrator: running at $url (pid $(json_field pid <<<"$status"))"; else echo "orchestrator: not running"; exit 1; fi
    ;;
  logs) exec tail -n 100 -f "$log" ;;
  *) echo "usage: orchestrator [open|serve|stop|restart|status|logs]" >&2; exit 2 ;;
esac
