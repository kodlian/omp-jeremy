{
  "name": "omp-git-diff-review",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "omp /review: browser diff review with a file tree, line comments sent back to the agent",
  "omp": {
    "extensions": ["./dist/extension.js"]
  },
  "scripts": {
    "build": "bun build web/main.jsx --outdir web/dist --splitting --format esm --minify --define 'process.env.NODE_ENV=\"production\"'",
    "prepare": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@primer/octicons-react": "19.43.0",
    "@primer/react": "38.47.0",
    "omp-integrations": "workspace:*",
    "omp-web-design-system": "workspace:*",
    "omp-web-client": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/bun": "latest"
  }
}
